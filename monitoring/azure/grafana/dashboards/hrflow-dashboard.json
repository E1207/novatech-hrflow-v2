{
  "title": "HRFlow Azure Operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "P99 latency",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, service))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error rate",
      "targets": [
        {
          "expr": "sum(rate(http_request_errors_total[5m])) by (service) / clamp_min(sum(rate(http_requests_total[5m])) by (service), 1)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Traffic",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) by (service)"
        }
      ]
    }
  ]
}
